# Public URL used for canonical, hreflang, sitemap, JSON-LD, llms.txt, QR codes and email links
NEXT_PUBLIC_SITE_URL=https://bistro.demo.kyrostudio.eu

# Supabase project "rotyi-bistro" (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Email via SMTP (used first). Gmail: smtp.gmail.com, port 465, your Gmail address,
# and a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# SECRET
SMTP_PASS=
# Optional sender, defaults to "Rotyi Bisztró <SMTP_USER>"
MAIL_FROM=
# Optional fallback provider
RESEND_API_KEY=
# Optional override for owner alerts (otherwise Owner alert email in /admin/menu)
BOOKING_INBOX=

# Web push for the staff app: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
